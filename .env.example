# Copia in .env.local e compila. Non committare mai .env.local.

# Supabase (Project Settings → API). La chiave anon è pubblica per definizione:
# la sicurezza dei dati è garantita dalle policy RLS del database.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Bucket pubblico per le foto delle uscite
VITE_SUPABASE_PHOTOS_BUCKET=uscite-foto

# Facoltativo: cartella Drive delle ispezioni. Se vuoto, il link si imposta dall'app
# (pulsante "Ispezioni" nel Magazzino) ed è condiviso con tutto lo staff.
VITE_INSPECTIONS_FOLDER_URL=
